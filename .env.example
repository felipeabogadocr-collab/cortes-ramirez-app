# Copia este archivo a .env.local para desarrollo local.
# En Vercel, configura estas mismas variables en Project Settings > Environment Variables.

# Supabase (Project Settings > API en el panel de Supabase)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# Solo en el servidor (Vercel), NUNCA con prefijo VITE_ (no debe llegar al navegador).
# Google AI Studio (gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
