# Copia este archivo a .env.local para desarrollo local.
# En Vercel, configura estas mismas variables en Project Settings > Environment Variables
# (proyecto "folio-pdf" en Vercel, NO el de la app interna del despacho).
#
# Usa los MISMOS valores del proyecto de Supabase que ya tiene la app interna
# (Project Settings > API en el panel de Supabase). Folio guarda sus datos en
# tablas nuevas y separadas (folio_leads, folio_eventos) dentro del mismo
# proyecto de Supabase — ver folio-pdf/supabase/schema.sql.
#
# Si no configuras estas variables, Folio sigue funcionando igual (unir,
# organizar, firmar, etc.) — solo no se guardan los registros ni funciona
# el panel de estadísticas en /panel.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY
